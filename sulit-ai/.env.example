# Copy to .env (git-ignored) and fill in.

# One of: openai | anthropic | gemini | ollama
LLM_PROVIDER=openai
# Examples: openai -> gpt-4o-mini | anthropic -> claude-3-5-haiku-latest | gemini -> gemini-2.0-flash | ollama -> llama3.2
LLM_MODEL=gpt-4o-mini
# Not required for ollama.
LLM_API_KEY=
# Optional override. For ollama defaults to http://localhost:11434/v1
LLM_BASE_URL=
# Leave empty to use the provider default.
LLM_TEMPERATURE=
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# Shared secret expected in the X-Internal-Api-Key header from sulit-java. Empty = disabled (local dev only).
INTERNAL_API_KEY=
