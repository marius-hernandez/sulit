# Copy to .env (git-ignored) and fill in. Run the app from the sulit-java directory so .env is picked up.

# Neon: convert "postgresql://user:pass@host/db?sslmode=require" to the JDBC form below (credentials go in separate vars).
DB_URL=jdbc:postgresql://<your-neon-host>.neon.tech/<db-name>?sslmode=require
DB_USERNAME=
DB_PWD=

SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AI_SERVICE_URL=http://localhost:8000
# Must match INTERNAL_API_KEY in sulit-ai/.env (leave both empty to disable in local dev).
AI_SERVICE_API_KEY=
