{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "sulit: dev (all)",
      "dependsOn": ["sulit: ai", "sulit: java", "sulit: fe"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "sulit: ai",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --reload --port 8000",
      "options": { "cwd": "${workspaceFolder}/sulit-ai" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "sulit" }
    },
    {
      "label": "sulit: java",
      "type": "shell",
      "command": ".\\mvnw.cmd spring-boot:run",
      "options": { "cwd": "${workspaceFolder}/sulit-java" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "sulit" }
    },
    {
      "label": "sulit: fe",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/sulit-fe" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "sulit" }
    },
    {
      "label": "sulit: health",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/health.ps1",
      "problemMatcher": []
    },
    {
      "label": "sulit: check",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check.ps1",
      "problemMatcher": []
    }
  ]
}
